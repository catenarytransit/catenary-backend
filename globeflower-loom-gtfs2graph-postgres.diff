diff --git a/src/globeflower/loom_main.rs b/src/globeflower/loom_main.rs
new file mode 100644
--- /dev/null
+++ b/src/globeflower/loom_main.rs
@@ -0,0 +1,99 @@
+use anyhow::{Context, Result};
+use clap::Parser;
+use log::info;
+use std::path::PathBuf;
+use std::time::Instant;
+
+mod loom_export;
+mod loom_gtfs_loader;
+mod loom_line_graph;
+mod loom_line_types;
+mod loom_builder;
+mod regions;
+mod loom_restrictions;
+
+use loom_gtfs_loader::GtfsLoader;
+use loom_builder::LoomLineGraphBuilder;
+use regions::Region;
+use loom_restrictions::TurnRestrictions;
+
+#[derive(Parser, Debug)]
+#[command(
+    author,
+    version,
+    about = "Build LOOM gtfs2graph-compatible line graphs from PostgreSQL GTFS"
+)]
+struct Args {
+    /// Region used to select current GTFS feed versions.
+    #[arg(long)]
+    region: String,
+
+    /// Output directory for generated files.
+    #[arg(long, default_value = ".")]
+    output_dir: PathBuf,
+}
+
+fn main() -> Result<()> {
+    dotenvy::dotenv().ok();
+    env_logger::Builder::from_env(env_logger::Env::default().default_filter_or("info")).init();
+
+    let args = Args::parse();
+    let total_started = Instant::now();
+    let region: Region = args
+        .region
+        .parse()
+        .map_err(|error: String| anyhow::anyhow!(error))?;
+    let region_config = region.config();
+
+    info!("Globeflower starting for region: {}", region_config.display_name);
+    info!(
+        "LOOM gtfs2graph mode: GTFS is authoritative; OSM/corridor processing is disabled"
+    );
+
+    let database_url = std::env::var("DATABASE_URL")
+        .context("DATABASE_URL environment variable is required by Globeflower")?;
+    let manager =
+        diesel::r2d2::ConnectionManager::<diesel::pg::PgConnection>::new(&database_url);
+    let pool = diesel::r2d2::Pool::builder()
+        .build(manager)
+        .context("creating Globeflower PostgreSQL pool")?;
+
+    let stage_started = Instant::now();
+    info!("[1/3] Reconstructing LOOM GTFS input from PostgreSQL...");
+    let input = GtfsLoader::new(pool, &region_config).load_loom_line_graph_input()?;
+    let lines = input.lines.clone();
+    info!(
+        "[1/3] PostgreSQL GTFS input ready in {:.2?}: {} lines, {} itinerary patterns",
+        stage_started.elapsed(),
+        lines.len(),
+        input.patterns.len()
+    );
+
+    let stage_started = Instant::now();
+    info!("[2/3] Running LOOM line graph construction...");
+    let (graph, observed_sequences) = LoomLineGraphBuilder::build(input)?;
+    let restrictions = TurnRestrictions::build_from_edge_sequences(&observed_sequences, &graph);
+    info!(
+        "[2/3] LOOM line graph ready in {:.2?}: {} nodes, {} edges",
+        stage_started.elapsed(),
+        graph.nodes.len(),
+        graph.edges.len()
+    );
+
+    let stage_started = Instant::now();
+    info!("[3/3] Writing outputs...");
+    std::fs::create_dir_all(&args.output_dir)?;
+    let geojson_path = args.output_dir.join(region.output_geojson_name());
+    loom_export::export_geojson(&graph, &lines, &restrictions, &geojson_path)?;
+    let binary_path = args.output_dir.join(region.output_graph_name());
+    loom_export::export_binary(&graph, &restrictions, &binary_path)?;
+    info!(
+        "[3/3] Output files written in {:.2?}: {:?}, {:?}",
+        stage_started.elapsed(),
+        geojson_path,
+        binary_path
+    );
+
+    info!("Globeflower complete in {:.2?}", total_started.elapsed());
+    Ok(())
+}
diff --git a/src/globeflower/loom_gtfs_loader.rs b/src/globeflower/loom_gtfs_loader.rs
new file mode 100644
--- /dev/null
+++ b/src/globeflower/loom_gtfs_loader.rs
@@ -0,0 +1,426 @@
+use anyhow::{Context, Result};
+use catenary::models::{ItineraryPatternMeta, ItineraryPatternRow, Route, Shape, Stop};
+use catenary::schema::gtfs::{itinerary_pattern, itinerary_pattern_meta, routes, shapes, stops};
+use diesel::dsl::sql;
+use diesel::prelude::*;
+use diesel::sql_types::Bool;
+use diesel::r2d2::{ConnectionManager, Pool};
+use log::{info, warn};
+use std::collections::{HashMap, HashSet};
+
+use crate::loom_line_types::{Line, LineId};
+use crate::regions::RegionConfig;
+
+pub type SyncPool = Pool<ConnectionManager<diesel::pg::PgConnection>>;
+
+#[derive(Debug, Clone)]
+pub struct LoomStop {
+    /// Internal identity. GTFS stop IDs are only unique inside one feed/version.
+    pub key: String,
+    /// Stable output identity for the current feed version.
+    pub station_id: String,
+    pub name: Option<String>,
+    /// WGS84 (lon, lat).
+    pub position: (f64, f64),
+}
+
+#[derive(Debug, Clone)]
+pub struct LoomPattern {
+    pub onestop_feed_id: String,
+    pub attempt_id: String,
+    pub line_id: LineId,
+    /// Every original GTFS trip represented by this compressed itinerary.
+    pub trip_ids: Vec<String>,
+    /// Ordered exactly by itinerary_pattern.stop_sequence.
+    pub stops: Vec<LoomStop>,
+    /// Original GTFS shape in WGS84, if one exists.
+    pub shape: Option<Vec<(f64, f64)>>,
+}
+
+#[derive(Debug, Clone)]
+pub struct LoomGraphInput {
+    pub lines: Vec<Line>,
+    pub patterns: Vec<LoomPattern>,
+}
+
+pub struct GtfsLoader {
+    pool: SyncPool,
+    bbox: (f64, f64, f64, f64),
+}
+
+impl GtfsLoader {
+    pub fn new(pool: SyncPool, region_config: &RegionConfig) -> Self {
+        Self {
+            pool,
+            bbox: region_config.bbox,
+        }
+    }
+
+    /// Reconstruct the subset of a cppgtfs Feed that LOOM's gtfs2graph Builder
+    /// consumes, but from Catenary's compressed PostgreSQL representation.
+    ///
+    /// The region is used only to select *feeds/attempts*. Once a current feed
+    /// touches the region we keep the complete selected-mode itinerary from that
+    /// feed, matching LOOM's whole-feed semantics and avoiding clipping a trip at
+    /// the region boundary.
+    pub fn load_loom_line_graph_input(&self) -> Result<LoomGraphInput> {
+        let mut conn = self.pool.get().context("getting PostgreSQL connection")?;
+        let selected_route_types: Vec<i16> = vec![0, 1, 2, 5, 7, 12];
+        let selected_type_set: HashSet<i16> = selected_route_types.iter().copied().collect();
+
+        let (west, south, east, north) = self.bbox;
+        let envelope = format!(
+            "ST_MakeEnvelope({}, {}, {}, {}, 4326)",
+            west, south, east, north
+        );
+
+        // The spatial query is only a feed/version selector. After selecting a
+        // feed attempt, all of its relevant stop pairs are loaded below so a
+        // route crossing the bbox is not clipped at the boundary.
+        info!("Selecting current rail GTFS feed attempts with PostGIS...");
+        let shape_spatial_predicate = format!("ST_Intersects(linestring, {})", envelope);
+        let shape_seeds: Vec<Shape> = shapes::table
+            .filter(shapes::route_type.eq_any(&selected_route_types))
+            .filter(shapes::allowed_spatial_query.eq(true))
+            .filter(sql::<Bool>(&shape_spatial_predicate))
+            .select(Shape::as_select())
+            .load(&mut conn)?;
+
+        let stop_spatial_predicate = format!("ST_Intersects(point, {})", envelope);
+        let stop_seeds: Vec<Stop> = stops::table
+            .filter(stops::allowed_spatial_query.eq(true))
+            .filter(sql::<Bool>(&stop_spatial_predicate))
+            .select(Stop::as_select())
+            .load(&mut conn)?;
+
+        // `allowed_spatial_query` is Catenary's current/production-version flag.
+        // The composite feed+attempt key prevents old GTFS versions from leaking
+        // into the graph.
+        let mut active_attempts: HashSet<(String, String)> = HashSet::new();
+        let mut active_chateaux: HashSet<String> = HashSet::new();
+
+        for shape in &shape_seeds {
+            active_attempts.insert((shape.onestop_feed_id.clone(), shape.attempt_id.clone()));
+            active_chateaux.insert(shape.chateau.clone());
+        }
+
+        for stop in &stop_seeds {
+            let has_selected_mode = stop
+                .route_types
+                .iter()
+                .flatten()
+                .any(|route_type| selected_type_set.contains(route_type));
+            if has_selected_mode {
+                active_attempts.insert((stop.onestop_feed_id.clone(), stop.attempt_id.clone()));
+                active_chateaux.insert(stop.chateau.clone());
+            }
+        }
+
+        if active_attempts.is_empty() {
+            info!("No current rail GTFS feed intersects the selected region");
+            return Ok(LoomGraphInput {
+                lines: Vec::new(),
+                patterns: Vec::new(),
+            });
+        }
+
+        let active_chateaux_vec = active_chateaux.into_iter().collect::<Vec<_>>();
+        info!(
+            "Selected {} current GTFS feed attempts across {} chateaux",
+            active_attempts.len(),
+            active_chateaux_vec.len()
+        );
+
+        let route_rows: Vec<Route> = routes::table
+            .filter(routes::route_type.eq_any(&selected_route_types))
+            .filter(routes::chateau.eq_any(&active_chateaux_vec))
+            .select(Route::as_select())
+            .load(&mut conn)?;
+
+        let mut route_by_key: HashMap<(String, String, String), Route> = HashMap::new();
+        let mut route_ids_for_query = HashSet::new();
+        for route in route_rows {
+            if !active_attempts.contains(&(route.onestop_feed_id.clone(), route.attempt_id.clone())) {
+                continue;
+            }
+            route_ids_for_query.insert(route.route_id.clone());
+            route_by_key.insert(
+                (
+                    route.onestop_feed_id.clone(),
+                    route.attempt_id.clone(),
+                    route.route_id.clone(),
+                ),
+                route,
+            );
+        }
+
+        if route_by_key.is_empty() {
+            return Ok(LoomGraphInput {
+                lines: Vec::new(),
+                patterns: Vec::new(),
+            });
+        }
+
+        let route_ids_for_query = route_ids_for_query.into_iter().collect::<Vec<_>>();
+        let meta_rows: Vec<ItineraryPatternMeta> = itinerary_pattern_meta::table
+            .filter(itinerary_pattern_meta::chateau.eq_any(&active_chateaux_vec))
+            .filter(itinerary_pattern_meta::route_id.eq_any(&route_ids_for_query))
+            .select(ItineraryPatternMeta::as_select())
+            .load(&mut conn)?;
+
+        let mut metas = Vec::new();
+        let mut pattern_ids_for_query = HashSet::new();
+        for meta in meta_rows {
+            let route_key = (
+                meta.onestop_feed_id.clone(),
+                meta.attempt_id.clone(),
+                meta.route_id.to_string(),
+            );
+            if route_by_key.contains_key(&route_key) {
+                pattern_ids_for_query.insert(meta.itinerary_pattern_id.clone());
+                metas.push(meta);
+            }
+        }
+
+        if metas.is_empty() {
+            return Ok(LoomGraphInput {
+                lines: Vec::new(),
+                patterns: Vec::new(),
+            });
+        }
+
+        let pattern_ids_for_query = pattern_ids_for_query.into_iter().collect::<Vec<_>>();
+        let itinerary_rows: Vec<ItineraryPatternRow> = itinerary_pattern::table
+            .filter(itinerary_pattern::chateau.eq_any(&active_chateaux_vec))
+            .filter(itinerary_pattern::itinerary_pattern_id.eq_any(&pattern_ids_for_query))
+            .select(ItineraryPatternRow::as_select())
+            .load(&mut conn)?;
+
+        let mut rows_by_pattern: HashMap<(String, String, String), Vec<ItineraryPatternRow>> =
+            HashMap::new();
+        for row in itinerary_rows {
+            let key = (
+                row.onestop_feed_id.clone(),
+                row.attempt_id.clone(),
+                row.itinerary_pattern_id.clone(),
+            );
+            if active_attempts.contains(&(row.onestop_feed_id.clone(), row.attempt_id.clone())) {
+                rows_by_pattern.entry(key).or_default().push(row);
+            }
+        }
+        for rows in rows_by_pattern.values_mut() {
+            rows.sort_by_key(|row| row.stop_sequence);
+        }
+
+        let required_stop_ids = rows_by_pattern
+            .values()
+            .flat_map(|rows| rows.iter().map(|row| row.stop_id.to_string()))
+            .collect::<HashSet<_>>()
+            .into_iter()
+            .collect::<Vec<_>>();
+        let required_stops: Vec<Stop> = if required_stop_ids.is_empty() {
+            Vec::new()
+        } else {
+            stops::table
+                .filter(stops::allowed_spatial_query.eq(true))
+                .filter(stops::chateau.eq_any(&active_chateaux_vec))
+                .filter(stops::gtfs_id.eq_any(&required_stop_ids))
+                .select(Stop::as_select())
+                .load(&mut conn)?
+        };
+
+        let mut stop_by_key: HashMap<(String, String, String), Stop> = HashMap::new();
+        for stop in required_stops {
+            if active_attempts.contains(&(stop.onestop_feed_id.clone(), stop.attempt_id.clone())) {
+                stop_by_key.insert(
+                    (
+                        stop.onestop_feed_id.clone(),
+                        stop.attempt_id.clone(),
+                        stop.gtfs_id.clone(),
+                    ),
+                    stop,
+                );
+            }
+        }
+
+        let required_shape_ids = metas
+            .iter()
+            .filter_map(|meta| meta.shape_id.clone())
+            .collect::<HashSet<_>>()
+            .into_iter()
+            .collect::<Vec<_>>();
+        let required_shapes: Vec<Shape> = if required_shape_ids.is_empty() {
+            Vec::new()
+        } else {
+            shapes::table
+                .filter(shapes::allowed_spatial_query.eq(true))
+                .filter(shapes::chateau.eq_any(&active_chateaux_vec))
+                .filter(shapes::shape_id.eq_any(&required_shape_ids))
+                .select(Shape::as_select())
+                .load(&mut conn)?
+        };
+
+        let mut shape_by_key: HashMap<(String, String, String), Vec<(f64, f64)>> = HashMap::new();
+        for shape in required_shapes {
+            if !active_attempts.contains(&(shape.onestop_feed_id.clone(), shape.attempt_id.clone())) {
+                continue;
+            }
+            let geometry = shape
+                .linestring
+                .points
+                .iter()
+                .map(|point| (point.x, point.y))
+                .collect::<Vec<_>>();
+            if geometry.len() >= 2 {
+                shape_by_key.insert(
+                    (shape.onestop_feed_id, shape.attempt_id, shape.shape_id),
+                    geometry,
+                );
+            }
+        }
+
+        // Keep one Catenary Line object per downstream line identity. This is the
+        // same route identity used by the previous Globeflower exporter.
+        let mut lines = Vec::new();
+        let mut seen_lines = HashSet::new();
+        for route in route_by_key.values() {
+            let line_id = LineId::new(route.chateau.clone(), route.route_id.clone());
+            if seen_lines.insert(line_id.clone()) {
+                lines.push(Line {
+                    id: line_id,
+                    label: route
+                        .short_name
+                        .clone()
+                        .or(route.long_name.clone())
+                        .unwrap_or_else(|| route.route_id.clone()),
+                    color: route.color.clone().unwrap_or_else(|| "888888".to_string()),
+                    route_type: route.route_type,
+                    agency_id: route.agency_id.clone(),
+                });
+            }
+        }
+        lines.sort_by(|a, b| a.id.to_string().cmp(&b.id.to_string()));
+
+        let mut patterns = Vec::new();
+        let mut skipped_missing_stop = 0usize;
+        let mut skipped_short = 0usize;
+
+        for meta in metas {
+            let pattern_key = (
+                meta.onestop_feed_id.clone(),
+                meta.attempt_id.clone(),
+                meta.itinerary_pattern_id.clone(),
+            );
+            let Some(rows) = rows_by_pattern.get(&pattern_key) else {
+                continue;
+            };
+            if rows.len() < 2 {
+                skipped_short += 1;
+                continue;
+            }
+
+            let mut trip_ids = meta.trip_ids.iter().flatten().cloned().collect::<Vec<_>>();
+            if trip_ids.is_empty() {
+                continue;
+            }
+            // cppgtfs stores trips in an unordered container. Sorting gives this
+            // port a deterministic traversal while preserving the same per-trip
+            // consume semantics.
+            trip_ids.sort_unstable();
+
+            let mut loom_stops = Vec::with_capacity(rows.len());
+            let mut valid = true;
+            for row in rows {
+                let stop_id = row.stop_id.to_string();
+                let stop_key = (
+                    row.onestop_feed_id.clone(),
+                    row.attempt_id.clone(),
+                    stop_id.clone(),
+                );
+                let Some(stop) = stop_by_key.get(&stop_key) else {
+                    valid = false;
+                    break;
+                };
+                let Some(point) = stop.point.as_ref() else {
+                    valid = false;
+                    break;
+                };
+
+                loom_stops.push(LoomStop {
+                    key: format!(
+                        "{}\u{0}{}\u{0}{}",
+                        row.onestop_feed_id, row.attempt_id, stop_id
+                    ),
+                    // Binary export groups by station_id, so include the feed
+                    // namespace to prevent unrelated feeds with equal stop_id
+                    // values from collapsing together.
+                    station_id: format!("{}:{}", row.onestop_feed_id, stop_id),
+                    name: stop.name.clone().or(stop.displayname.clone()),
+                    position: (point.x, point.y),
+                });
+            }
+            if !valid {
+                skipped_missing_stop += 1;
+                continue;
+            }
+
+            let route_key = (
+                meta.onestop_feed_id.clone(),
+                meta.attempt_id.clone(),
+                meta.route_id.to_string(),
+            );
+            let Some(route) = route_by_key.get(&route_key) else {
+                continue;
+            };
+            let line_id = LineId::new(route.chateau.clone(), route.route_id.clone());
+
+            let shape = meta.shape_id.as_ref().and_then(|shape_id| {
+                shape_by_key
+                    .get(&(
+                        meta.onestop_feed_id.clone(),
+                        meta.attempt_id.clone(),
+                        shape_id.clone(),
+                    ))
+                    .cloned()
+            });
+
+            patterns.push(LoomPattern {
+                onestop_feed_id: meta.onestop_feed_id,
+                attempt_id: meta.attempt_id,
+                line_id,
+                trip_ids,
+                stops: loom_stops,
+                shape,
+            });
+        }
+
+        patterns.sort_by(|a, b| {
+            a.onestop_feed_id
+                .cmp(&b.onestop_feed_id)
+                .then_with(|| a.attempt_id.cmp(&b.attempt_id))
+                .then_with(|| a.line_id.to_string().cmp(&b.line_id.to_string()))
+                .then_with(|| a.trip_ids.first().cmp(&b.trip_ids.first()))
+        });
+
+        if skipped_missing_stop > 0 {
+            warn!(
+                "Skipped {} itinerary patterns because a referenced current stop was missing coordinates",
+                skipped_missing_stop
+            );
+        }
+        if skipped_short > 0 {
+            info!("Skipped {} one-stop itinerary patterns", skipped_short);
+        }
+
+        info!(
+            "LOOM PostgreSQL input ready: {} lines, {} itinerary patterns, {} virtual GTFS trips",
+            lines.len(),
+            patterns.len(),
+            patterns.iter().map(|pattern| pattern.trip_ids.len()).sum::<usize>()
+        );
+
+        Ok(LoomGraphInput { lines, patterns })
+    }
+
+
+}
diff --git a/src/globeflower/loom_line_types.rs b/src/globeflower/loom_line_types.rs
new file mode 100644
--- /dev/null
+++ b/src/globeflower/loom_line_types.rs
@@ -0,0 +1,42 @@
+use serde::{Deserialize, Serialize};
+use std::fmt;
+
+/// Identifier for a transit line. LOOM's gtfs2graph treats a GTFS route as the
+/// line identity; direction is represented on each edge occurrence instead.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct LineId {
+    pub chateau: String,
+    pub route_id: String,
+}
+
+impl LineId {
+    pub fn new(chateau: impl Into<String>, route_id: impl Into<String>) -> Self {
+        Self {
+            chateau: chateau.into(),
+            route_id: route_id.into(),
+        }
+    }
+}
+
+impl fmt::Display for LineId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}:{}", self.chateau, self.route_id)
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Line {
+    pub id: LineId,
+    pub label: String,
+    pub color: String,
+    pub route_type: i16,
+    pub agency_id: Option<String>,
+}
+
+/// Occurrence of a line on an undirected edge. `direction_node` is the node
+/// toward which the line travels, or None when trips occur in both directions.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct LineOcc {
+    pub line: LineId,
+    pub direction_node: Option<u64>,
+}
diff --git a/src/globeflower/loom_line_graph.rs b/src/globeflower/loom_line_graph.rs
new file mode 100644
--- /dev/null
+++ b/src/globeflower/loom_line_graph.rs
@@ -0,0 +1,51 @@
+use crate::loom_line_types::LineOcc;
+use ahash::{HashMap, HashMapExt};
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct SupportNodeId(pub u64);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct SupportEdgeId(pub u64);
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SupportNode {
+    pub id: SupportNodeId,
+    pub position: (f64, f64),
+    pub station_id: Option<String>,
+    pub station_label: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SupportEdge {
+    pub id: SupportEdgeId,
+    pub from: SupportNodeId,
+    pub to: SupportNodeId,
+    pub geometry: Vec<(f64, f64)>,
+    pub length_m: f64,
+    pub lines: Vec<LineOcc>,
+}
+
+/// Minimal undirected line graph used by the LOOM-compatible construction
+/// phase. There is deliberately no OSM/corridor state here.
+pub struct SupportGraph {
+    pub nodes: HashMap<SupportNodeId, SupportNode>,
+    pub edges: HashMap<SupportEdgeId, SupportEdge>,
+    pub node_edges: HashMap<SupportNodeId, Vec<SupportEdgeId>>,
+}
+
+impl SupportGraph {
+    pub fn new() -> Self {
+        Self {
+            nodes: HashMap::new(),
+            edges: HashMap::new(),
+            node_edges: HashMap::new(),
+        }
+    }
+}
+
+impl Default for SupportGraph {
+    fn default() -> Self {
+        Self::new()
+    }
+}
