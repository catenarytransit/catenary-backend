+use crate::loom_gtfs_loader::{LoomGraphInput, LoomStop};
+use crate::loom_line_types::{LineId, LineOcc};
+use crate::loom_line_graph::{
+    SupportEdge, SupportEdgeId, SupportGraph, SupportNode, SupportNodeId,
+};
+use ahash::{HashMap, HashMapExt};
+use anyhow::Result;
+use log::info;
+
+const WEB_MERCATOR_RADIUS_M: f64 = 6_378_137.0;
+const WEB_MERCATOR_MAX_LAT: f64 = 85.051_128_779_806_6;
+const LOOM_GEOMETRY_EQUALITY_M: f64 = 10.0;
+const LOOM_INCLUDED_GEOMETRY_M: f64 = 50.0;
+const LOOM_AVERAGING_STEP_M: f64 = 20.0;
+
+#[derive(Debug, Clone)]
+struct RouteOccurrence {
+    direction_node: Option<SupportNodeId>,
+    trip_count: usize,
+}
+
+impl RouteOccurrence {
+    fn new(direction_node: SupportNodeId) -> Self {
+        Self {
+            direction_node: Some(direction_node),
+            trip_count: 1,
+        }
+    }
+
+    fn add(&mut self, direction_node: SupportNodeId, count: usize) {
+        if self.direction_node != Some(direction_node) {
+            self.direction_node = None;
+        }
+        self.trip_count += count;
+    }
+}
+
+#[derive(Debug, Clone)]
+struct EdgeTripGeometry {
+    // Always oriented from TempEdge::from to TempEdge::to, just like LOOM's
+    // EdgePL::addEdgeTripGeom normalizes geometry direction to edge->getTo().
+    geometry: Vec<(f64, f64)>,
+    routes: HashMap<LineId, RouteOccurrence>,
+}
+
+#[derive(Debug, Clone)]
+struct TempEdge {
+    id: SupportEdgeId,
+    from: SupportNodeId,
+    to: SupportNodeId,
+    geoms: Vec<EdgeTripGeometry>,
+}
+
+pub struct LoomLineGraphBuilder;
+
+impl LoomLineGraphBuilder {
+    pub fn build(input: LoomGraphInput) -> Result<(SupportGraph, Vec<(LineId, Vec<SupportEdgeId>)>)> {
+        info!(
+            "LOOM builder input: {} lines, {} itinerary patterns",
+            input.lines.len(),
+            input.patterns.len()
+        );
+
+        let mut graph = SupportGraph::new();
+        let mut node_by_stop: HashMap<String, SupportNodeId> = HashMap::new();
+        let mut edge_by_pair: HashMap<(u64, u64), SupportEdgeId> = HashMap::new();
+        let mut temp_edges: HashMap<SupportEdgeId, TempEdge> = HashMap::new();
+        let mut next_node_id = 0_u64;
+        let mut next_edge_id = 0_u64;
+
+        // cppgtfs stores Feed::getTrips() in an unordered container, so the C++
+        // implementation does not define a stable cross-trip iteration order. The
+        // database stores many identical trips in an itinerary pattern. Rebuild a
+        // deterministic virtual trip stream while keeping Builder::consume()'s
+        // exact per-trip state transitions.
+        let mut virtual_trips: Vec<(usize, usize)> = Vec::new();
+        for (pattern_idx, pattern) in input.patterns.iter().enumerate() {
+            for trip_idx in 0..pattern.trip_ids.len() {
+                virtual_trips.push((pattern_idx, trip_idx));
+            }
+        }
+        virtual_trips.sort_unstable_by(|&(pa, ta), &(pb, tb)| {
+            let a = &input.patterns[pa];
+            let b = &input.patterns[pb];
+            a.onestop_feed_id
+                .cmp(&b.onestop_feed_id)
+                .then_with(|| a.trip_ids[ta].cmp(&b.trip_ids[tb]))
+        });
+
+        info!("LOOM virtual trip stream: {} trips", virtual_trips.len());
+
+        let mut pattern_sequences: Vec<Option<Vec<SupportEdgeId>>> =
+            vec![None; input.patterns.len()];
+        let mut geom_cache: Vec<HashMap<(usize, usize), Vec<(f64, f64)>>> =
+            (0..input.patterns.len()).map(|_| HashMap::new()).collect();
+        let shape_mercator = input
+            .patterns
+            .iter()
+            .map(|pattern| {
+                pattern.shape.as_ref().map(|shape| {
+                    shape
+                        .iter()
+                        .map(|&(lon, lat)| lon_lat_to_web_mercator(lon, lat))
+                        .collect::<Vec<_>>()
+                })
+            })
+            .collect::<Vec<_>>();
+        let total_virtual_trips = virtual_trips.len();
+
+        for (ordinal, (pattern_idx, _trip_idx)) in virtual_trips.into_iter().enumerate() {
+            let pattern = &input.patterns[pattern_idx];
+            if pattern.stops.len() < 2 {
+                continue;
+            }
+
+            let mut prev_stop_idx = 0_usize;
+            let mut prev_node = get_or_create_node(
+                &mut graph,
+                &mut node_by_stop,
+                &pattern.stops[0],
+                &mut next_node_id,
+            );
+            let mut trip_sequence = Vec::with_capacity(pattern.stops.len().saturating_sub(1));
+
+            for cur_stop_idx in 1..pattern.stops.len() {
+                let cur_node = get_or_create_node(
+                    &mut graph,
+                    &mut node_by_stop,
+                    &pattern.stops[cur_stop_idx],
+                    &mut next_node_id,
+                );
+
+                // This deliberately mirrors LOOM's continue-before-prev-update
+                // behavior for repeated stops / round-trip self edges.
+                if prev_node == cur_node {
+                    continue;
+                }
+
+                let edge_id = get_or_create_edge(
+                    &mut edge_by_pair,
+                    &mut temp_edges,
+                    prev_node,
+                    cur_node,
+                    &mut next_edge_id,
+                );
+
+                let geom = if let Some(cached) =
+                    geom_cache[pattern_idx].get(&(prev_stop_idx, cur_stop_idx))
+                {
+                    cached.clone()
+                } else {
+                    let geom = stop_to_stop_geometry(
+                        shape_mercator[pattern_idx].as_deref(),
+                        &pattern.stops[prev_stop_idx],
+                        &pattern.stops[cur_stop_idx],
+                    );
+                    geom_cache[pattern_idx]
+                        .insert((prev_stop_idx, cur_stop_idx), geom.clone());
+                    geom
+                };
+
+                add_trip_to_edge(
+                    temp_edges.get_mut(&edge_id).expect("edge was just inserted"),
+                    pattern.line_id.clone(),
+                    cur_node,
+                    geom,
+                );
+
+                trip_sequence.push(edge_id);
+                prev_stop_idx = cur_stop_idx;
+                prev_node = cur_node;
+            }
+
+            if pattern_sequences[pattern_idx].is_none() {
+                pattern_sequences[pattern_idx] = Some(trip_sequence);
+            }
+
+            if (ordinal + 1) % 10_000 == 0 {
+                info!(
+                    "LOOM consume: {}/{} virtual trips, {} nodes, {} edges",
+                    ordinal + 1,
+                    total_virtual_trips,
+                    graph.nodes.len(),
+                    temp_edges.len()
+                );
+            }
+        }
+
+        // Builder::simplify() with LOOM's default prune threshold of zero:
+        // combine geometries contained in longer alternatives, then average all
+        // remaining geometry alternatives on each undirected stop-pair edge.
+        for edge in temp_edges.values_mut() {
+            combine_included_geometries(&mut edge.geoms);
+            average_combine_geometries(&mut edge.geoms);
+        }
+
+        let mut temp_edge_list: Vec<_> = temp_edges.into_values().collect();
+        temp_edge_list.sort_by_key(|edge| edge.id.0);
+
+        for temp in temp_edge_list {
+            let Some(ref_geom) = temp.geoms.first() else {
+                continue;
+            };
+
+            let geometry: Vec<(f64, f64)> = ref_geom
+                .geometry
+                .iter()
+                .map(|&(x, y)| web_mercator_to_lon_lat(x, y))
+                .collect();
+
+            let mut line_ids: Vec<_> = ref_geom.routes.keys().cloned().collect();
+            line_ids.sort_by(|a, b| a.to_string().cmp(&b.to_string()));
+
+            let lines: Vec<LineOcc> = line_ids
+                .into_iter()
+                .filter_map(|line_id| {
+                    ref_geom.routes.get(&line_id).map(|occ| LineOcc {
+                        line: line_id,
+                        direction_node: occ.direction_node.map(|id| id.0),
+                    })
+                })
+                .collect();
+
+            if lines.is_empty() {
+                continue;
+            }
+
+            graph.node_edges.entry(temp.from).or_default().push(temp.id);
+            graph.node_edges.entry(temp.to).or_default().push(temp.id);
+            graph.edges.insert(
+                temp.id,
+                SupportEdge {
+                    id: temp.id,
+                    from: temp.from,
+                    to: temp.to,
+                    length_m: polyline_length_lon_lat(&geometry),
+                    geometry,
+                    lines,
+                },
+            );
+        }
+
+        let sequences = pattern_sequences
+            .into_iter()
+            .zip(input.patterns.iter())
+            .filter_map(|(seq, pattern)| seq.map(|s| (pattern.line_id.clone(), s)))
+            .collect::<Vec<_>>();
+
+        info!(
+            "LOOM line graph complete: {} nodes, {} edges, {} route-pattern sequences",
+            graph.nodes.len(),
+            graph.edges.len(),
+            sequences.len()
+        );
+
+        Ok((graph, sequences))
+    }
+}
+
+fn get_or_create_node(
+    graph: &mut SupportGraph,
+    node_by_stop: &mut HashMap<String, SupportNodeId>,
+    stop: &LoomStop,
+    next_node_id: &mut u64,
+) -> SupportNodeId {
+    if let Some(id) = node_by_stop.get(&stop.key) {
+        return *id;
+    }
+
+    let id = SupportNodeId(*next_node_id);
+    *next_node_id += 1;
+
+    graph.nodes.insert(
+        id,
+        SupportNode {
+            id,
+            position: stop.position,
+            station_id: Some(stop.station_id.clone()),
+            station_label: stop.name.clone(),
+        },
+    );
+    graph.node_edges.entry(id).or_default();
+    node_by_stop.insert(stop.key.clone(), id);
+    id
+}
+
+fn get_or_create_edge(
+    edge_by_pair: &mut HashMap<(u64, u64), SupportEdgeId>,
+    edges: &mut HashMap<SupportEdgeId, TempEdge>,
+    from: SupportNodeId,
+    to: SupportNodeId,
+    next_edge_id: &mut u64,
+) -> SupportEdgeId {
+    let pair = if from.0 < to.0 {
+        (from.0, to.0)
+    } else {
+        (to.0, from.0)
+    };
+    if let Some(id) = edge_by_pair.get(&pair) {
+        return *id;
+    }
+
+    let id = SupportEdgeId(*next_edge_id);
+    *next_edge_id += 1;
+    edge_by_pair.insert(pair, id);
+    edges.insert(
+        id,
+        TempEdge {
+            id,
+            from,
+            to,
+            geoms: Vec::new(),
+        },
+    );
+    id
+}
+
+fn add_trip_to_edge(
+    edge: &mut TempEdge,
+    line_id: LineId,
+    direction_node: SupportNodeId,
+    mut geometry: Vec<(f64, f64)>,
+) {
+    // Normalize geometry to the edge's stored direction. LOOM does this when a
+    // new EdgeTripGeom is inserted and stores all reference geometries pointing
+    // toward edge->getTo().
+    if direction_node != edge.to {
+        geometry.reverse();
+    }
+
+    if let Some(existing) = edge
+        .geoms
+        .iter_mut()
+        .find(|candidate| polylines_equal(&candidate.geometry, &geometry, LOOM_GEOMETRY_EQUALITY_M))
+    {
+        let averaged =
+            average_polylines(&[existing.geometry.as_slice(), geometry.as_slice()]);
+        existing.geometry = averaged;
+        match existing.routes.get_mut(&line_id) {
+            Some(route) => route.add(direction_node, 1),
+            None => {
+                existing
+                    .routes
+                    .insert(line_id, RouteOccurrence::new(direction_node));
+            }
+        }
+        return;
+    }
+
+    let mut routes = HashMap::new();
+    routes.insert(line_id, RouteOccurrence::new(direction_node));
+    edge.geoms.push(EdgeTripGeometry { geometry, routes });
+}
+
+fn combine_included_geometries(geoms: &mut Vec<EdgeTripGeometry>) {
+    if geoms.len() < 2 {
+        return;
+    }
+
+    let mut i = 0;
+    while i < geoms.len() {
+        let candidate = (0..geoms.len()).find(|&j| {
+            j != i
+                && polyline_length(&geoms[j].geometry) > polyline_length(&geoms[i].geometry)
+                && polyline_contains(
+                    &geoms[j].geometry,
+                    &geoms[i].geometry,
+                    LOOM_INCLUDED_GEOMETRY_M,
+                )
+                && !polyline_contains(
+                    &geoms[i].geometry,
+                    &geoms[j].geometry,
+                    LOOM_INCLUDED_GEOMETRY_M,
+                )
+        });
+
+        if let Some(j) = candidate {
+            let removed = geoms.remove(i);
+            let target_idx = if j > i { j - 1 } else { j };
+            merge_route_occurrences(&mut geoms[target_idx].routes, removed.routes);
+        } else {
+            i += 1;
+        }
+    }
+}
+
+fn average_combine_geometries(geoms: &mut Vec<EdgeTripGeometry>) {
+    if geoms.len() < 2 {
+        return;
+    }
+
+    let refs = geoms.iter().map(|g| g.geometry.as_slice()).collect::<Vec<_>>();
+    let geometry = average_polylines(&refs);
+    let mut routes: HashMap<LineId, RouteOccurrence> = HashMap::new();
+    for geom in geoms.drain(..) {
+        merge_route_occurrences(&mut routes, geom.routes);
+    }
+    geoms.push(EdgeTripGeometry { geometry, routes });
+}
+
+fn merge_route_occurrences(
+    target: &mut HashMap<LineId, RouteOccurrence>,
+    incoming: HashMap<LineId, RouteOccurrence>,
+) {
+    for (line, occ) in incoming {
+        match target.get_mut(&line) {
+            Some(existing) => match occ.direction_node {
+                Some(dir) => existing.add(dir, occ.trip_count),
+                None => {
+                    existing.direction_node = None;
+                    existing.trip_count += occ.trip_count;
+                }
+            },
+            None => {
+                target.insert(line, occ);
+            }
+        }
+    }
+}
+
+fn stop_to_stop_geometry(
+    shape_m: Option<&[(f64, f64)]>,
+    from: &LoomStop,
+    to: &LoomStop,
+) -> Vec<(f64, f64)> {
+    let from_m = lon_lat_to_web_mercator(from.position.0, from.position.1);
+    let to_m = lon_lat_to_web_mercator(to.position.0, to.position.1);
+
+    let Some(shape_m) = shape_m else {
+        return vec![from_m, to_m];
+    };
+    if shape_m.len() < 2 {
+        return vec![from_m, to_m];
+    }
+
+    let start = project_on_after(from_m, shape_m, 0);
+    let Some(start) = start else {
+        return vec![from_m, to_m];
+    };
+    let end = project_on_after(to_m, shape_m, start.segment_idx);
+    let Some(end) = end else {
+        return vec![from_m, to_m];
+    };
+
+    let mut result = Vec::new();
+    result.push(start.point);
+    if start.segment_idx + 1 <= end.segment_idx {
+        result.extend_from_slice(&shape_m[start.segment_idx + 1..=end.segment_idx]);
+    }
+    result.push(end.point);
+    douglas_peucker(&result, 0.0)
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Projection {
+    segment_idx: usize,
+    point: (f64, f64),
+}
+
+fn project_on_after(
+    point: (f64, f64),
+    polyline: &[(f64, f64)],
+    start_segment: usize,
+) -> Option<Projection> {
+    if polyline.is_empty() || start_segment >= polyline.len() {
+        return None;
+    }
+    if polyline.len() == 1 || start_segment == polyline.len() - 1 {
+        return Some(Projection {
+            segment_idx: polyline.len() - 1,
+            point: *polyline.last().unwrap(),
+        });
+    }
+
+    let mut best: Option<(usize, (f64, f64), f64)> = None;
+    for segment_idx in start_segment..polyline.len() - 1 {
+        let projected = project_to_segment(point, polyline[segment_idx], polyline[segment_idx + 1]);
+        let distance = point_distance(point, projected);
+        if best.as_ref().map_or(true, |(_, _, d)| distance < *d) {
+            best = Some((segment_idx, projected, distance));
+        }
+    }
+
+    best.map(|(segment_idx, point, _)| Projection { segment_idx, point })
+}
+
+fn project_to_segment(
+    p: (f64, f64),
+    a: (f64, f64),
+    b: (f64, f64),
+) -> (f64, f64) {
+    let dx = b.0 - a.0;
+    let dy = b.1 - a.1;
+    let denom = dx * dx + dy * dy;
+    if denom <= f64::EPSILON {
+        return a;
+    }
+    let t = (((p.0 - a.0) * dx + (p.1 - a.1) * dy) / denom).clamp(0.0, 1.0);
+    (a.0 + t * dx, a.1 + t * dy)
+}
+
+fn polylines_equal(a: &[(f64, f64)], b: &[(f64, f64)], dmax: f64) -> bool {
+    if a.len() == 2 && b.len() == 2 {
+        return (point_distance(a[0], b[0]) < dmax && point_distance(a[1], b[1]) < dmax)
+            || (point_distance(a[0], b[1]) < dmax
+                && point_distance(a[1], b[0]) < dmax);
+    }
+    polyline_contains(a, b, dmax) && polyline_contains(b, a, dmax)
+}
+
+fn polyline_contains(container: &[(f64, f64)], candidate: &[(f64, f64)], dmax: f64) -> bool {
+    candidate
+        .iter()
+        .all(|&point| point_to_polyline_distance(point, container) <= dmax)
+}
+
+fn point_to_polyline_distance(point: (f64, f64), polyline: &[(f64, f64)]) -> f64 {
+    if polyline.len() < 2 {
+        return polyline
+            .first()
+            .map(|&p| point_distance(point, p))
+            .unwrap_or(f64::INFINITY);
+    }
+    polyline
+        .windows(2)
+        .map(|segment| point_distance(point, project_to_segment(point, segment[0], segment[1])))
+        .fold(f64::INFINITY, f64::min)
+}
+
+fn average_polylines(lines: &[&[(f64, f64)]]) -> Vec<(f64, f64)> {
+    if lines.is_empty() {
+        return Vec::new();
+    }
+    if lines.len() == 1 {
+        return lines[0].to_vec();
+    }
+
+    if lines.len() == 2 && lines[0].len() == 2 && lines[1].len() == 2 {
+        return vec![
+            (
+                (lines[0][0].0 + lines[1][0].0) / 2.0,
+                (lines[0][0].1 + lines[1][0].1) / 2.0,
+            ),
+            (
+                (lines[0][1].0 + lines[1][1].0) / 2.0,
+                (lines[0][1].1 + lines[1][1].1) / 2.0,
+            ),
+        ];
+    }
+
+    let longest = lines
+        .iter()
+        .map(|line| polyline_length(line))
+        .fold(0.0_f64, f64::max);
+    if longest <= f64::EPSILON {
+        return lines[0].to_vec();
+    }
+
+    let step = LOOM_AVERAGING_STEP_M / longest;
+    let mut result = Vec::new();
+    let mut fraction = 0.0;
+    loop {
+        let at = fraction.min(1.0_f64);
+        let mut x = 0.0;
+        let mut y = 0.0;
+        for line in lines {
+            let p = point_at_fraction(line, at);
+            x += p.0;
+            y += p.1;
+        }
+        result.push((x / lines.len() as f64, y / lines.len() as f64));
+        if at >= 1.0 {
+            break;
+        }
+        fraction += step;
+        if fraction > 1.0 {
+            fraction = 1.0;
+        }
+    }
+
+    douglas_peucker(&result, 0.0001)
+}
+
+fn point_at_fraction(polyline: &[(f64, f64)], fraction: f64) -> (f64, f64) {
+    if polyline.is_empty() {
+        return (0.0, 0.0);
+    }
+    if polyline.len() == 1 {
+        return polyline[0];
+    }
+    let total = polyline_length(polyline);
+    if total <= f64::EPSILON {
+        return polyline[0];
+    }
+    let target = total * fraction.clamp(0.0, 1.0);
+    let mut walked = 0.0;
+    for segment in polyline.windows(2) {
+        let len = point_distance(segment[0], segment[1]);
+        if walked + len >= target {
+            if len <= f64::EPSILON {
+                return segment[0];
+            }
+            let t = (target - walked) / len;
+            return (
+                segment[0].0 + t * (segment[1].0 - segment[0].0),
+                segment[0].1 + t * (segment[1].1 - segment[0].1),
+            );
+        }
+        walked += len;
+    }
+    *polyline.last().unwrap()
+}
+
+fn polyline_length(polyline: &[(f64, f64)]) -> f64 {
+    polyline
+        .windows(2)
+        .map(|segment| point_distance(segment[0], segment[1]))
+        .sum()
+}
+
+fn point_distance(a: (f64, f64), b: (f64, f64)) -> f64 {
+    ((a.0 - b.0).powi(2) + (a.1 - b.1).powi(2)).sqrt()
+}
+
+fn douglas_peucker(points: &[(f64, f64)], tolerance: f64) -> Vec<(f64, f64)> {
+    if points.len() < 3 {
+        return points.to_vec();
+    }
+
+    let first = points[0];
+    let last = *points.last().unwrap();
+    let mut max_distance = -1.0_f64;
+    let mut max_index = 0_usize;
+    for (idx, &point) in points[1..points.len() - 1].iter().enumerate() {
+        let distance = point_distance(point, project_to_segment(point, first, last));
+        if distance > max_distance {
+            max_distance = distance;
+            max_index = idx + 1;
+        }
+    }
+
+    if max_distance > tolerance {
+        let left = douglas_peucker(&points[..=max_index], tolerance);
+        let right = douglas_peucker(&points[max_index..], tolerance);
+        let mut result = left;
+        result.pop();
+        result.extend(right);
+        result
+    } else {
+        vec![first, last]
+    }
+}
+
+fn lon_lat_to_web_mercator(lon: f64, lat: f64) -> (f64, f64) {
+    let lat = lat.clamp(-WEB_MERCATOR_MAX_LAT, WEB_MERCATOR_MAX_LAT);
+    let x = WEB_MERCATOR_RADIUS_M * lon.to_radians();
+    let y = WEB_MERCATOR_RADIUS_M
+        * (std::f64::consts::FRAC_PI_4 + lat.to_radians() / 2.0)
+            .tan()
+            .ln();
+    (x, y)
+}
+
+fn web_mercator_to_lon_lat(x: f64, y: f64) -> (f64, f64) {
+    let lon = (x / WEB_MERCATOR_RADIUS_M).to_degrees();
+    let lat = (2.0 * (y / WEB_MERCATOR_RADIUS_M).exp().atan() - std::f64::consts::FRAC_PI_2)
+        .to_degrees();
+    (lon, lat)
+}
+
+
+fn polyline_length_lon_lat(polyline: &[(f64, f64)]) -> f64 {
+    const R: f64 = 6_371_007.2;
+    polyline
+        .windows(2)
+        .map(|segment| {
+            let (lon1, lat1) = (segment[0].0.to_radians(), segment[0].1.to_radians());
+            let (lon2, lat2) = (segment[1].0.to_radians(), segment[1].1.to_radians());
+            let dlat = lat2 - lat1;
+            let dlon = lon2 - lon1;
+            let a = (dlat / 2.0).sin().powi(2)
+                + lat1.cos() * lat2.cos() * (dlon / 2.0).sin().powi(2);
+            2.0 * R * a.sqrt().atan2((1.0 - a).sqrt())
+        })
+        .sum()
+}
diff --git a/src/globeflower/loom_restrictions.rs b/src/globeflower/loom_restrictions.rs
new file mode 100644
--- /dev/null
+++ b/src/globeflower/loom_restrictions.rs
@@ -0,0 +1,168 @@
+use crate::loom_line_graph::{SupportEdge, SupportEdgeId, SupportGraph, SupportNodeId};
+use crate::loom_line_types::{LineId, LineOcc};
+use ahash::{HashMap, HashMapExt, HashSet, HashSetExt};
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ExcludedConnection {
+    pub node_from: SupportNodeId,
+    pub node_to: SupportNodeId,
+    pub line: LineId,
+}
+
+/// LOOM records the route-specific edge pairs that actually occur in trips at
+/// each node. Every direction-compatible pair carrying the same line that was
+/// never observed is emitted as `excluded_conn`.
+pub struct TurnRestrictions {
+    allowed: HashMap<(SupportNodeId, LineId), HashSet<(SupportEdgeId, SupportEdgeId)>>,
+}
+
+impl TurnRestrictions {
+    pub fn new() -> Self {
+        Self {
+            allowed: HashMap::new(),
+        }
+    }
+
+    pub fn build_from_edge_sequences(
+        sequences: &[(LineId, Vec<SupportEdgeId>)],
+        graph: &SupportGraph,
+    ) -> Self {
+        let mut restrictions = Self::new();
+
+        for (line_id, edges) in sequences {
+            for pair in edges.windows(2) {
+                let a = pair[0];
+                let b = pair[1];
+                let (Some(edge_a), Some(edge_b)) = (graph.edges.get(&a), graph.edges.get(&b))
+                else {
+                    continue;
+                };
+                let Some(node) = shared_node(edge_a, edge_b) else {
+                    continue;
+                };
+
+                // NodePL::isConnOccuring() in LOOM treats the connection as an
+                // unordered pair, even though it was observed in one trip order.
+                let allowed = restrictions
+                    .allowed
+                    .entry((node, line_id.clone()))
+                    .or_default();
+                allowed.insert((a, b));
+                allowed.insert((b, a));
+            }
+        }
+
+        restrictions
+    }
+
+    pub fn excluded_connections_at_node(
+        &self,
+        node_id: SupportNodeId,
+        graph: &SupportGraph,
+    ) -> Vec<ExcludedConnection> {
+        self.excluded_transitions_at_node(node_id, graph)
+            .into_iter()
+            .filter_map(|(from_edge_id, to_edge_id, line)| {
+                let from_edge = graph.edges.get(&from_edge_id)?;
+                let to_edge = graph.edges.get(&to_edge_id)?;
+                Some(ExcludedConnection {
+                    node_from: far_endpoint(from_edge, node_id),
+                    node_to: far_endpoint(to_edge, node_id),
+                    line,
+                })
+            })
+            .collect()
+    }
+
+    pub fn excluded_transitions_at_node(
+        &self,
+        node_id: SupportNodeId,
+        graph: &SupportGraph,
+    ) -> Vec<(SupportEdgeId, SupportEdgeId, LineId)> {
+        let Some(edge_ids) = graph.node_edges.get(&node_id) else {
+            return Vec::new();
+        };
+        if edge_ids.len() < 2 {
+            return Vec::new();
+        }
+
+        let mut exclusions = Vec::new();
+
+        // This is intentionally the same nested-edge test as NodePL::getAttrs():
+        // compare occurrences on every pair of distinct incident edges, require
+        // the same route, require compatible directions through this node, and
+        // exclude the pair only if that route connection never occurred.
+        for &from_edge_id in edge_ids {
+            let Some(from_edge) = graph.edges.get(&from_edge_id) else {
+                continue;
+            };
+            for from_occ in &from_edge.lines {
+                for &to_edge_id in edge_ids {
+                    if from_edge_id == to_edge_id {
+                        continue;
+                    }
+                    let Some(to_edge) = graph.edges.get(&to_edge_id) else {
+                        continue;
+                    };
+                    for to_occ in &to_edge.lines {
+                        if from_occ.line != to_occ.line {
+                            continue;
+                        }
+                        if !direction_compatible(node_id, from_occ, to_occ) {
+                            continue;
+                        }
+
+                        let is_allowed = self
+                            .allowed
+                            .get(&(node_id, from_occ.line.clone()))
+                            .is_some_and(|pairs| pairs.contains(&(from_edge_id, to_edge_id)));
+                        if !is_allowed {
+                            exclusions.push((
+                                from_edge_id,
+                                to_edge_id,
+                                from_occ.line.clone(),
+                            ));
+                        }
+                    }
+                }
+            }
+        }
+
+        exclusions
+    }
+}
+
+impl Default for TurnRestrictions {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+fn direction_compatible(node: SupportNodeId, a: &LineOcc, b: &LineOcc) -> bool {
+    let a_dir = a.direction_node.map(SupportNodeId);
+    let b_dir = b.direction_node.map(SupportNodeId);
+
+    a_dir.is_none()
+        || b_dir.is_none()
+        || (a_dir == Some(node) && b_dir != Some(node))
+        || (a_dir != Some(node) && b_dir == Some(node))
+}
+
+fn shared_node(a: &SupportEdge, b: &SupportEdge) -> Option<SupportNodeId> {
+    if a.from == b.from || a.from == b.to {
+        Some(a.from)
+    } else if a.to == b.from || a.to == b.to {
+        Some(a.to)
+    } else {
+        None
+    }
+}
+
+fn far_endpoint(edge: &SupportEdge, node: SupportNodeId) -> SupportNodeId {
+    if edge.from == node {
+        edge.to
+    } else {
+        edge.from
+    }
+}
diff --git a/src/globeflower/loom_export.rs b/src/globeflower/loom_export.rs
new file mode 100644
--- /dev/null
+++ b/src/globeflower/loom_export.rs
@@ -0,0 +1,278 @@
+use crate::loom_line_graph::{SupportEdgeId, SupportGraph, SupportNode, SupportNodeId};
+use crate::loom_line_types::{Line, LineId};
+use crate::loom_restrictions::TurnRestrictions;
+use anyhow::Result;
+use catenary::graph_formats::{
+    LandMass, NodeId, SerializableExportGraph, SerializableGraphEdge, SerializableStop,
+    SerializableStopCluster, TurnRestriction,
+};
+use geojson::{Feature, FeatureCollection, Geometry, JsonObject, JsonValue};
+use log::info;
+use serde_json::json;
+use std::collections::{HashMap, HashSet};
+use std::fs::File;
+use std::io::Write;
+use std::path::Path;
+
+pub fn export_geojson(
+    graph: &SupportGraph,
+    lines: &[Line],
+    restrictions: &TurnRestrictions,
+    output_path: &Path,
+) -> Result<()> {
+    info!("Exporting LOOM-compatible GeoJSON to {:?}", output_path);
+
+    let line_map: HashMap<&LineId, &Line> = lines.iter().map(|line| (&line.id, line)).collect();
+    let used_line_ids: HashSet<&LineId> = graph
+        .edges
+        .values()
+        .flat_map(|edge| edge.lines.iter().map(|occ| &occ.line))
+        .collect();
+
+    let lines_array: Vec<JsonValue> = lines
+        .iter()
+        .filter(|line| used_line_ids.contains(&line.id))
+        .map(|line| {
+            json!({
+                "id": line.id.to_string(),
+                "label": line.label,
+                "color": line.color
+            })
+        })
+        .collect();
+
+    let mut features = Vec::with_capacity(graph.nodes.len() + graph.edges.len());
+
+    // LOOM's GeoGraphJsonOutput writes every graph node, including isolated
+    // one-stop nodes. Do not filter nodes by edge incidence here.
+    let mut node_ids = graph.nodes.keys().copied().collect::<Vec<_>>();
+    node_ids.sort_by_key(|id| id.0);
+    for node_id in node_ids {
+        let node = &graph.nodes[&node_id];
+        let degree = graph.node_edges.get(&node_id).map_or(0, Vec::len);
+        let mut props = JsonObject::new();
+        props.insert("id".to_string(), json!(node.id.0.to_string()));
+        props.insert("deg".to_string(), json!(degree.to_string()));
+        props.insert("deg_out".to_string(), json!(degree.to_string()));
+        props.insert("deg_in".to_string(), json!(degree.to_string()));
+
+        if let Some(label) = &node.station_label {
+            props.insert("station_label".to_string(), json!(label));
+        }
+        if let Some(station_id) = &node.station_id {
+            props.insert("station_id".to_string(), json!(station_id));
+        }
+
+        let exclusions = restrictions.excluded_connections_at_node(node.id, graph);
+        if !exclusions.is_empty() {
+            props.insert(
+                "excluded_conn".to_string(),
+                json!(exclusions
+                    .iter()
+                    .map(|exclusion| json!({
+                        "node_from": exclusion.node_from.0.to_string(),
+                        "node_to": exclusion.node_to.0.to_string(),
+                        "line": exclusion.line.to_string()
+                    }))
+                    .collect::<Vec<_>>()),
+            );
+        }
+
+        features.push(Feature {
+            bbox: None,
+            geometry: Some(Geometry::new(geojson::Value::Point(vec![
+                node.position.0,
+                node.position.1,
+            ]))),
+            id: None,
+            properties: Some(props),
+            foreign_members: None,
+        });
+    }
+
+    let mut edge_ids = graph.edges.keys().copied().collect::<Vec<_>>();
+    edge_ids.sort_by_key(|id| id.0);
+    for edge_id in edge_ids {
+        let edge = &graph.edges[&edge_id];
+        let mut props = JsonObject::new();
+        props.insert("id".to_string(), json!(edge.id.0.to_string()));
+        props.insert("from".to_string(), json!(edge.from.0.to_string()));
+        props.insert("to".to_string(), json!(edge.to.0.to_string()));
+        props.insert(
+            "lines".to_string(),
+            json!(edge
+                .lines
+                .iter()
+                .map(|occ| {
+                    let line = line_map.get(&occ.line);
+                    json!({
+                        "id": occ.line.to_string(),
+                        "label": line.map(|line| line.label.as_str()).unwrap_or(""),
+                        "color": line.map(|line| line.color.as_str()).unwrap_or("888888"),
+                        "direction": occ.direction_node.map(|node| node.to_string())
+                    })
+                })
+                .collect::<Vec<_>>()),
+        );
+
+        features.push(Feature {
+            bbox: None,
+            geometry: Some(Geometry::new(geojson::Value::LineString(
+                edge.geometry
+                    .iter()
+                    .map(|&(lon, lat)| vec![lon, lat])
+                    .collect(),
+            ))),
+            id: None,
+            properties: Some(props),
+            foreign_members: None,
+        });
+    }
+
+    let mut fc_props = JsonObject::new();
+    fc_props.insert("lines".to_string(), json!(lines_array));
+    fc_props.insert("generator".to_string(), json!("globeflower-loom-gtfs2graph"));
+
+    let collection = FeatureCollection {
+        bbox: None,
+        features,
+        foreign_members: Some(fc_props),
+    };
+    let mut file = File::create(output_path)?;
+    file.write_all(serde_json::to_string_pretty(&collection)?.as_bytes())?;
+
+    info!("Exported {} GeoJSON features", collection.features.len());
+    Ok(())
+}
+
+pub fn export_binary(
+    graph: &SupportGraph,
+    restrictions: &TurnRestrictions,
+    output_path: &Path,
+) -> Result<()> {
+    info!("Exporting binary format to {:?}", output_path);
+
+    let mut edges = Vec::new();
+    let mut clusters = Vec::new();
+    let mut edge_index: HashMap<SupportEdgeId, usize> = HashMap::new();
+    let mut station_to_cluster: HashMap<String, usize> = HashMap::new();
+
+    let mut node_ids = graph.nodes.keys().copied().collect::<Vec<_>>();
+    node_ids.sort_by_key(|id| id.0);
+    for node_id in node_ids {
+        let node = &graph.nodes[&node_id];
+        if let (Some(station_id), Some(label)) = (&node.station_id, &node.station_label) {
+            if !station_to_cluster.contains_key(station_id) {
+                let cluster_id = clusters.len();
+                station_to_cluster.insert(station_id.clone(), cluster_id);
+                clusters.push(SerializableStopCluster {
+                    cluster_id,
+                    centroid: [node.position.0, node.position.1],
+                    stops: vec![SerializableStop {
+                        id: station_id.clone(),
+                        code: None,
+                        name: Some(label.clone()),
+                        description: None,
+                        location_type: 1,
+                        parent_station: None,
+                        zone_id: None,
+                        longitude: Some(node.position.0),
+                        latitude: Some(node.position.1),
+                        timezone: None,
+                        platform_code: None,
+                        level_id: None,
+                        routes: vec![],
+                    }],
+                });
+            }
+        }
+    }
+
+    let mut edge_ids = graph.edges.keys().copied().collect::<Vec<_>>();
+    edge_ids.sort_by_key(|id| id.0);
+    for edge_id in edge_ids {
+        let edge = &graph.edges[&edge_id];
+        edge_index.insert(edge_id, edges.len());
+        edges.push(SerializableGraphEdge {
+            from: convert_node(edge.from, &graph.nodes),
+            to: convert_node(edge.to, &graph.nodes),
+            geometry: edge
+                .geometry
+                .iter()
+                .map(|&(lon, lat)| [lon, lat])
+                .collect(),
+            route_ids: edge
+                .lines
+                .iter()
+                .map(|occ| (occ.line.chateau.clone(), occ.line.route_id.clone()))
+                .collect(),
+            weight: edge.length_m,
+            original_edge_index: None,
+        });
+    }
+
+    let land_masses = build_land_masses(&edges, &clusters);
+    let mut turn_restrictions = Vec::new();
+    for node_id in graph.nodes.keys() {
+        for (from_edge, to_edge, line) in restrictions.excluded_transitions_at_node(*node_id, graph)
+        {
+            let (Some(&from_idx), Some(&to_idx)) =
+                (edge_index.get(&from_edge), edge_index.get(&to_edge))
+            else {
+                continue;
+            };
+            turn_restrictions.push(TurnRestriction {
+                from_edge_index: from_idx,
+                to_edge_index: to_idx,
+                route_id: (line.chateau, line.route_id),
+            });
+        }
+    }
+
+    let export = SerializableExportGraph {
+        land_masses,
+        edges,
+        clusters,
+        restrictions: turn_restrictions,
+    };
+    let encoded = bincode::serde::encode_to_vec(&export, bincode::config::standard())?;
+    std::fs::write(output_path, encoded)?;
+
+    info!(
+        "Exported {} edges, {} clusters to binary",
+        export.edges.len(),
+        export.clusters.len()
+    );
+    Ok(())
+}
+
+fn convert_node(
+    node_id: SupportNodeId,
+    nodes: &ahash::HashMap<SupportNodeId, SupportNode>,
+) -> NodeId {
+    if nodes
+        .get(&node_id)
+        .is_some_and(|node| node.station_id.is_some())
+    {
+        NodeId::Cluster(node_id.0 as usize)
+    } else {
+        NodeId::Intersection(0, node_id.0 as usize)
+    }
+}
+
+fn build_land_masses(
+    edges: &[SerializableGraphEdge],
+    clusters: &[SerializableStopCluster],
+) -> Vec<LandMass> {
+    vec![LandMass {
+        id: 0,
+        clusters: clusters.iter().map(|cluster| cluster.cluster_id).collect(),
+        edges: (0..edges.len()).collect(),
+        stop_count: clusters.iter().map(|cluster| cluster.stops.len()).sum(),
+        route_count: edges
+            .iter()
+            .flat_map(|edge| &edge.route_ids)
+            .collect::<HashSet<_>>()
+            .len(),
+    }]
+}
